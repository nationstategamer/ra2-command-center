      <TextBlock Text="Choose more battlefield space or a larger, easier-to-read interface." Style="{StaticResource Hint}" Margin="0,7,0,20"/>
      <UniformGrid Columns="4">
       <RadioButton x:Name="ClassicProfile" GroupName="Profile" Style="{StaticResource Profile}" AutomationProperties.Name="Classic profile 640 by 480"><StackPanel><TextBlock Text="01 / CLASSIC" FontSize="10" Foreground="#B9A98B"/><TextBlock Text="640 × 480" FontFamily="Bahnschrift" FontSize="20" Margin="0,14,0,10"/><TextBlock Text="Original proportions" Style="{StaticResource Hint}" FontSize="11"/></StackPanel></RadioButton>
       <RadioButton x:Name="ReadableProfile" GroupName="Profile" Style="{StaticResource Profile}" AutomationProperties.Name="Readable profile 1280 by 720"><StackPanel><TextBlock Text="02 / READABLE" FontSize="10" Foreground="#B9A98B"/><TextBlock Text="1280 × 720" FontFamily="Bahnschrift" FontSize="20" Margin="0,14,0,10"/><TextBlock Text="Larger units &amp; UI" Style="{StaticResource Hint}" FontSize="11"/></StackPanel></RadioButton>
       <RadioButton x:Name="BalancedProfile" GroupName="Profile" Style="{StaticResource Profile}" AutomationProperties.Name="Balanced profile 1600 by 900"><StackPanel><TextBlock Text="03 / BALANCED" FontSize="10" Foreground="#B9A98B"/><TextBlock Text="1600 × 900" FontFamily="Bahnschrift" FontSize="20" Margin="0,14,0,10"/><TextBlock Text="Space meets clarity" Style="{StaticResource Hint}" FontSize="11"/></StackPanel></RadioButton>
       <RadioButton x:Name="WideProfile" GroupName="Profile" Style="{StaticResource Profile}" Margin="0" AutomationProperties.Name="Wide View profile 1920 by 1080"><StackPanel><TextBlock Text="04 / WIDE VIEW" FontSize="10" Foreground="#B9A98B"/><TextBlock Text="1920 × 1080" FontFamily="Bahnschrift" FontSize="20" Margin="0,14,0,10"/><TextBlock Text="Maximum map space" Style="{StaticResource Hint}" FontSize="11"/></StackPanel></RadioButton>
      </UniformGrid>
      <TextBlock x:Name="ProfileSummary" Text="Classic / Original 4:3 image. Side borders preserve the proportions." Style="{StaticResource Hint}" Margin="0,14,0,23"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock x:Name="DisplayModeLabel" Text="Display mode · both games" Margin="0,0,0,9"/><ComboBox x:Name="DisplayMode" AutomationProperties.Name="Display mode"><ComboBoxItem Content="Borderless fullscreen"/><ComboBoxItem Content="Exclusive fullscreen"/></ComboBox><TextBlock Text="Borderless makes switching between apps easier." Style="{StaticResource Hint}" Margin="0,8,0,0"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock x:Name="ScalingModeLabel" Text="Image scaling · both games" Margin="0,0,0,9"/><ComboBox x:Name="ScalingMode" AutomationProperties.Name="Image scaling"><ComboBoxItem Content="Crisp pixels"/><ComboBoxItem Content="Smooth image"/></ComboBox><TextBlock Text="Preserves the original aspect ratio." Style="{StaticResource Hint}" Margin="0,8,0,0"/></StackPanel>
      </Grid>
