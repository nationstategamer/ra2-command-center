      </Grid>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem Header="BACKUP &amp; RESTORE" AutomationProperties.Name="Backup and restore"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,10">
      <TextBlock Text="Every change has a way back" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="A verified copy of your current settings is saved before each apply or restore." Style="{StaticResource Hint}" Margin="0,7,0,23"/>
      <Border BorderBrush="#3C4944" BorderThickness="1" Background="#1B2623" Padding="20"><StackPanel><TextBlock Text="ORIGINAL BACKUP" Style="{StaticResource Eyebrow}" Foreground="#A3C0A6"/><TextBlock x:Name="BaselineInfo" Text="Original settings, graphics wrapper and saves are protected." Margin="0,10,0,8"/><TextBlock x:Name="RestoreScopeHint" Text="Restore puts both games’ configuration files back exactly as they were before Command Center. Saves and game binaries are left in place." Style="{StaticResource Hint}"/><Button x:Name="RestoreOriginalButton" Style="{StaticResource Quiet}" Content="Restore original settings" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel></Border>
      <Border BorderBrush="#3A4349" BorderThickness="1" Background="#1B2227" Padding="20" Margin="0,17,0,0"><StackPanel><TextBlock Text="PREVIOUS SETTINGS" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="UndoScopeHint" Text="Undo the most recent apply or restore for both games." Style="{StaticResource Hint}" Margin="0,10,0,0"/><Button x:Name="UndoButton" Style="{StaticResource Quiet}" Content="Undo last settings change" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border>
      <Button x:Name="OpenBackupsButton" Style="{StaticResource Quiet}" Content="Open backup folder  ↗" HorizontalAlignment="Left" Margin="0,18,0,0"/>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem x:Name="SkirmishTab" Header="SKIRMISH" AutomationProperties.Name="Skirmish presets"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,10">
      <TextBlock Text="Skirmish setups, ready to go" FontSize="19" FontWeight="SemiBold"/>
      <TextBlock x:Name="SkirmishIntro" Text="The game already remembers your last skirmish setup, so a rematch is one click on its Skirmish screen. Presets keep several setups and switch between them before you launch." Style="{StaticResource Hint}" Margin="0,7,0,20"/>
      <Border Background="#20282C" BorderBrush="#3A464C" BorderThickness="1" Padding="18,14"><StackPanel>
       <TextBlock Text="CURRENT SETUP" Style="{StaticResource Eyebrow}"/>
       <TextBlock x:Name="SkirmishCurrent" Text="" TextWrapping="Wrap" Margin="0,8,0,14"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="PresetName" MaxLength="40" AutomationProperties.Name="Preset name" VerticalContentAlignment="Center"/>
        <Button x:Name="SavePresetButton" Grid.Column="1" Style="{StaticResource Quiet}" Content="Save as preset" Margin="10,0,0,0" Padding="16,10"/>
       </Grid>
       <TextBlock Text="Name the setup currently chosen in the game, for example “1v1 Brutal”." Style="{StaticResource Hint}" FontSize="11" Margin="0,6,0,0"/>
      </StackPanel></Border>
      <TextBlock Text="SAVED PRESETS" Style="{StaticResource Eyebrow}" Margin="0,22,0,10"/>
      <ListBox x:Name="PresetList" MinHeight="120" MaxHeight="220" AutomationProperties.Name="Saved skirmish presets"/>
      <TextBlock x:Name="PresetEmpty" Text="No presets yet. Set up a skirmish in the game, exit, then save it here." Style="{StaticResource Hint}" Margin="0,8,0,0"/>
      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
       <Button x:Name="UsePresetButton" Style="{StaticResource Quiet}" Content="Use selected preset" Padding="16,10"/>
       <Button x:Name="DeletePresetButton" Style="{StaticResource Quiet}" Content="Delete" Margin="10,0,0,0" Padding="16,10"/>
      </StackPanel>
      <TextBlock Text="Using a preset changes only the game’s skirmish setup: opponents, credits, options and map choice. Your current settings are backed up first, so Undo in Backup &amp; Restore reverses it." Style="{StaticResource Hint}" Margin="0,12,0,0"/>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem x:Name="SavesTab" Header="SAVES" AutomationProperties.Name="Saved games"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,10">
      <TextBlock Text="Your saved games" FontSize="19" FontWeight="SemiBold"/>
      <TextBlock x:Name="SavesSummary" Text="" Style="{StaticResource Hint}" Margin="0,7,0,16"/>
      <ListBox x:Name="SaveList" MinHeight="150" MaxHeight="300" AutomationProperties.Name="Saved games"/>
      <TextBlock x:Name="SavesEmpty" Text="No saved games for this game yet." Style="{StaticResource Hint}" Margin="0,8,0,0"/>
      <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBox x:Name="SaveName" MaxLength="40" AutomationProperties.Name="New save name" VerticalContentAlignment="Center"/>
       <Button x:Name="RenameSaveButton" Grid.Column="1" Style="{StaticResource Quiet}" Content="Rename" Margin="10,0,0,0" Padding="16,10"/>
       <Button x:Name="DeleteSaveButton" Grid.Column="2" Style="{StaticResource Quiet}" Content="Delete" Margin="10,0,0,0" Padding="16,10"/>
      </Grid>
      <TextBlock Text="Rename changes the name shown in the game’s Load menu; a copy of the save is kept first. Delete moves the save to a Deleted saves folder, so you can move it back." Style="{StaticResource Hint}" Margin="0,10,0,0"/>
      <Button x:Name="OpenDeletedSavesButton" Style="{StaticResource Quiet}" Content="Open deleted saves folder  ↗" HorizontalAlignment="Left" Margin="0,14,0,0"/>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem x:Name="EnhancedInfoTab" Header="IN-GAME UI" Visibility="Collapsed" AutomationProperties.Name="In-game UI"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,10">
      <TextBlock x:Name="EnhancedInfoHeading" Text="More information. The familiar battlefield." FontSize="19" FontWeight="SemiBold"/>
      <TextBlock x:Name="EnhancedInfoIntro" Text="This separate Yuri’s Revenge edition keeps the original artwork, sidebar and faction identity." Style="{StaticResource Hint}" Margin="0,7,0,23"/>
      <Border x:Name="Ra2FeatureInfo" Visibility="Collapsed" Background="#20282C" BorderBrush="#3A464C" BorderThickness="1" Padding="18,14" Margin="0,0,0,16"><StackPanel>
       <DockPanel><TextBlock Text="Changes apply the next time the game starts." DockPanel.Dock="Right" Style="{StaticResource Hint}" FontSize="11" VerticalAlignment="Center"/><TextBlock Text="IN-GAME FEATURES" Style="{StaticResource Eyebrow}"/></DockPanel>
       <CheckBox x:Name="IdleHarvesterCheck" Content="Next Idle Harvester  ·  key I" AutomationProperties.Name="Next Idle Harvester" Margin="0,12,0,0"/>
       <TextBlock Text="Selects the next harvester that is not mining or unloading and centers the view on it." Style="{StaticResource Hint}" Margin="28,0,0,8"/>
       <CheckBox x:Name="QuickSaveCheck" Content="Quick Save  ·  Ctrl+S" AutomationProperties.Name="Quick Save" Margin="0,4,0,0"/>
       <TextBlock Text="Saves a campaign or skirmish game to one quick-save slot. Load it from the normal Load menu. Both keys can be changed in the game under Options › Keyboard." Style="{StaticResource Hint}" Margin="28,0,0,8"/>
       <CheckBox x:Name="GameClockCheck" Content="Game clock" AutomationProperties.Name="Game clock" Margin="0,4,0,0"/>
       <TextBlock Text="Elapsed game time on the battlefield, with the game’s own timers. It counts game time, so it runs faster at higher game speeds." Style="{StaticResource Hint}" Margin="28,0,0,8"/>
       <CheckBox x:Name="MatchStatsCheck" Content="Match stats" AutomationProperties.Name="Match stats" Margin="0,4,0,0"/>
       <TextBlock Text="“Kills · Lost · Army $” above the battlefield timers: enemy units and buildings you destroyed, yours that were destroyed, and what your current units cost (harvesters excluded)." Style="{StaticResource Hint}" Margin="28,0,0,8"/>
       <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <CheckBox x:Name="AutosaveCheck" Content="Autosave every" AutomationProperties.Name="Autosave" Margin="0" VerticalAlignment="Center"/>
        <ComboBox x:Name="AutosaveInterval" Grid.Column="1" Margin="10,0,0,0" AutomationProperties.Name="Autosave interval"><ComboBoxItem Content="5 minutes"/><ComboBoxItem Content="10 minutes"/><ComboBoxItem Content="15 minutes"/><ComboBoxItem Content="30 minutes"/></ComboBox>
       </Grid>
       <TextBlock Text="Saves campaign and skirmish games to three rotating “Autosave” slots in the normal Load menu. Only time spent playing counts; pauses and menus don’t." Style="{StaticResource Hint}" Margin="28,2,0,8"/>
       <CheckBox x:Name="RangeCirclesCheck" Content="Range circles for selected defenses" AutomationProperties.Name="Range circles for selected defenses" Margin="0,4,0,0"/>
       <TextBlock Text="Select one of your defenses (Pillbox, Prism Tower, Tesla Coil and others) to see its firing range, drawn with the game’s own range indicator." Style="{StaticResource Hint}" Margin="28,0,0,12"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="Health bars" VerticalAlignment="Center" Margin="0,0,14,0"/>
        <ComboBox x:Name="HealthBarMode" Grid.Column="1" AutomationProperties.Name="Health bars"><ComboBoxItem Content="Selected units only (original)"/><ComboBoxItem Content="Damaged units and buildings"/><ComboBoxItem Content="All units and buildings"/></ComboBox>
       </Grid>
       <TextBlock Text="Shows the game’s own health bar without selecting. Selected units keep their usual selection box." Style="{StaticResource Hint}" Margin="0,6,0,0"/>
      </StackPanel></Border>
      <StackPanel x:Name="SmartAiInfo" Visibility="Collapsed">
       <Border Background="#20282C" BorderBrush="#3A464C" BorderThickness="1" Padding="18,14" Margin="0,0,0,22"><StackPanel>
        <CheckBox x:Name="SmartAiCheck" Content="Smarter skirmish AI (experimental)" AutomationProperties.Name="Smarter skirmish AI"/>
        <TextBlock Text="On: Medium Enemy and Brutal Enemy opponents use tuned team compositions and attack plans. Off: the original Red Alert 2 AI. The in-game UI improvements stay on either way. Changes apply when you start the next skirmish." Style="{StaticResource Hint}" Margin="0,2,0,0"/>
       </StackPanel></Border>
       <TextBlock Text="MEDIUM &amp; BRUTAL OPPONENTS" Style="{StaticResource Eyebrow}"/><TextBlock Text="With the smarter AI on, tuned team compositions and attack plans give these skirmish opponents more useful choices." Style="{StaticResource Hint}" Margin="0,7,0,20"/>
       <TextBlock Text="ORIGINAL UNIT BALANCE" Style="{StaticResource Eyebrow}"/><TextBlock Text="This edition adds no unit-stat changes or extra economy bonuses. The game’s existing difficulty rules still apply." Style="{StaticResource Hint}" Margin="0,7,0,20"/>
       <TextBlock Text="START A NEW SKIRMISH" Style="{StaticResource Eyebrow}"/><TextBlock Text="Choose Medium Enemy or Brutal Enemy in each opponent's dropdown. Easy Enemy keeps the original AI. Start a new match; this copy has its own settings and saves." Style="{StaticResource Hint}" Margin="0,7,0,23"/>
      </StackPanel>
      <TextBlock Text="EXPANDED TOOLTIPS" Style="{StaticResource Eyebrow}"/><TextBlock Text="See useful build information when you point at a sidebar icon." Style="{StaticResource Hint}" Margin="0,7,0,20"/>
      <TextBlock Text="BUILDING PLACEMENT PREVIEWS" Style="{StaticResource Eyebrow}"/><TextBlock Text="A translucent preview helps you place structures on the battlefield." Style="{StaticResource Hint}" Margin="0,7,0,20"/>
      <TextBlock Text="ECONOMY INDICATORS" Style="{StaticResource Eyebrow}"/><TextBlock Text="Keep track of harvesting activity and available power beside the familiar sidebar." Style="{StaticResource Hint}" Margin="0,7,0,23"/>
      <Border Background="#1B2623" BorderBrush="#3C4944" BorderThickness="1" Padding="18"><StackPanel><TextBlock Text="A separate edition, with an easy way back" FontWeight="SemiBold"/><TextBlock x:Name="EnhancedReturnHint" Text="Use Standard games to return to the original games. This edition has its own settings and saves. Start a new game here; keep existing original saves in the original games. The Backup &amp; Restore tab resets this copy’s display and audio settings, while keeping the UI package installed." Style="{StaticResource Hint}" Margin="0,8,0,0"/></StackPanel></Border>
     </StackPanel></ScrollViewer></TabItem>
    </TabControl>
   </Grid>
  </Grid>
  <Border Grid.Row="3" Background="#1B2125" BorderBrush="#3B4348" BorderThickness="0,1,0,0"><Grid Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,15,0"><TextBlock x:Name="StatusText" Text="Ready. Your original files are backed up." FontSize="13"/><TextBlock x:Name="StatusDetail" Text="Select a profile, then apply your settings." Foreground="#99A5AB" FontSize="11" Margin="0,5,0,0"/></StackPanel><Button x:Name="DiscardButton" Grid.Column="1" Style="{StaticResource Quiet}" Content="Discard changes" Margin="0,0,12,0" VerticalAlignment="Center"/><Button x:Name="ApplyButton" Grid.Column="2" Style="{StaticResource Primary}" Content="APPLY SETTINGS" Padding="24,12" VerticalAlignment="Center"/></Grid></Border>
 </Grid></Border>
</Window>
