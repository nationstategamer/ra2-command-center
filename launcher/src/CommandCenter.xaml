   <Border Width="46" Height="48" BorderBrush="#E25058" BorderThickness="2" Background="#86212B" HorizontalAlignment="Left"><TextBlock Text="II" Foreground="#F7EBDD" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="33" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="COMMAND &amp; CONQUER" FontSize="10" Foreground="#B7A98F" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal"><TextBlock Text="RED ALERT 2" FontFamily="Bahnschrift" FontSize="27" FontWeight="Bold"/><TextBlock x:Name="WindowSubtitle" Text=" / COMMAND CENTER" FontSize="12" Foreground="#9DA6AA" Margin="15,9,0,0"/></StackPanel></StackPanel>
   <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,7,0,0"><Button x:Name="MinimizeButton" Style="{StaticResource WindowButton}" Content="—" AutomationProperties.Name="Minimize"/><Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}" Content="□" AutomationProperties.Name="Maximize or restore window"/><Button x:Name="CloseButton" Style="{StaticResource WindowButton}" Content="✕" AutomationProperties.Name="Close"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="248"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
