    <Border x:Name="EnhancedBanner" Grid.Row="1" Visibility="Collapsed" Background="#332126" BorderBrush="#86434A" BorderThickness="1" Padding="13,10" Margin="0,0,0,16"><TextBlock x:Name="EnhancedBannerText" TextWrapping="Wrap" Text="ENHANCED YURI UI  ·  Clearer tooltips, placement previews and economy indicators. Separate settings and saves." FontSize="12" Foreground="#E1CCB3"/></Border>
