     <Button x:Name="SmartModeButton" Style="{StaticResource Quiet}" Content="Smart Skirmish AI" Margin="0,8,0,0" Padding="10,10" Visibility="Collapsed"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,25,0,0"><TextBlock Style="{StaticResource Eyebrow}" Text="FIELD TOOLS" Margin="0,0,0,13"/><Button x:Name="EditorButton" Style="{StaticResource Quiet}" Content="Open map editor" Margin="0,0,0,8"/><Button x:Name="ManualButton" Style="{StaticResource Quiet}" Content="Read field manual"/></StackPanel>
