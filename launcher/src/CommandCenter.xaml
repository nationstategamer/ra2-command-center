    <StackPanel><TextBlock x:Name="GameSelectorHeading" Style="{StaticResource Eyebrow}" Text="SELECT YOUR GAME" Margin="0,0,0,17"/>
     <RadioButton x:Name="Ra2Choice" GroupName="Game" Style="{StaticResource GameChoice}" IsChecked="True" AutomationProperties.Name="Red Alert 2"><StackPanel><TextBlock x:Name="Ra2ChoiceTitle" Text="RED ALERT 2" FontFamily="Bahnschrift" FontWeight="SemiBold" FontSize="17"/><TextBlock x:Name="Ra2ChoiceHint" Text="Original campaign &amp; skirmish" Style="{StaticResource Hint}" Margin="0,5,0,0"/></StackPanel></RadioButton>
     <RadioButton x:Name="YuriChoice" GroupName="Game" Style="{StaticResource GameChoice}" AutomationProperties.Name="Yuri's Revenge"><StackPanel><TextBlock x:Name="YuriChoiceTitle" Text="YURI’S REVENGE" FontFamily="Bahnschrift" FontWeight="SemiBold" FontSize="17"/><TextBlock x:Name="YuriChoiceHint" Text="Expansion campaign &amp; skirmish" Style="{StaticResource Hint}" Margin="0,5,0,0"/></StackPanel></RadioButton>
     <Button x:Name="LaunchButton" Style="{StaticResource Primary}" Margin="0,8,0,0" Padding="10,15" Content="▶   LAUNCH GAME"/>
     <TextBlock x:Name="LaunchHint" Text="Launches with your saved settings." Style="{StaticResource Hint}" Margin="0,10,0,0" FontSize="11"/>
     <Button x:Name="EnhancedModeButton" Style="{StaticResource Quiet}" Content="Enhanced Yuri UI" Margin="0,14,0,0" Padding="10,10"/>
     <Button x:Name="NativeModeButton" Style="{StaticResource Quiet}" Content="Enhanced Red Alert 2" Margin="0,8,0,0" Padding="10,10"/>
