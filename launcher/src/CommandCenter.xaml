 </Window.Resources>
 <Border BorderBrush="#51575B" BorderThickness="1" Background="#101316"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="5"/><RowDefinition Height="87"/><RowDefinition Height="*"/><RowDefinition Height="77"/></Grid.RowDefinitions>
