      <TextBlock Text="Tune your command environment" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="AudioGameHint" Text="These settings are saved separately for each game." Style="{StaticResource Hint}" Margin="0,7,0,23"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="35"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="AUDIO LEVELS" Style="{StaticResource Eyebrow}" Margin="0,0,0,18"/>
        <DockPanel><TextBlock x:Name="SoundValue" Text="70%" DockPanel.Dock="Right" Foreground="#D6B77C"/><TextBlock Text="Sound effects"/></DockPanel><Slider x:Name="SoundSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Sound effects volume" Margin="0,8,0,18"/>
